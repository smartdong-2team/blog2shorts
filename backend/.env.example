# 복사해서 backend/.env 로 사용 (.env 는 Git에 올리지 않음)
APP_ENV=development

# JSON 배열 형식
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 실제 키는 .env 에만 작성
OPENAI_API_KEY=
# 대본 모델은 이미지 입력과 Structured Outputs를 지원해야 합니다
# OPENAI_SCRIPT_MODEL=gpt-4.1-mini
# OPENAI_TTS_MODEL=tts-1

# 대본 생성 AI: openai(기본) 또는 nvidia (build.nvidia.com 무료 API). 음성은 항상 OpenAI
# SCRIPT_PROVIDER=nvidia
# NVIDIA_API_KEY=
# NVIDIA_SCRIPT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NAVER_BLOG_IDS=["copper567"]
# STORAGE_DIR=./storage
