# 복사해서 backend/.env 로 사용 (.env 는 Git에 올리지 않음)
APP_ENV=development

# JSON 배열 형식
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 실제 키는 .env 에만 작성
OPENAI_API_KEY=
# 대본 모델은 이미지 입력과 Structured Outputs를 지원해야 합니다
# OPENAI_SCRIPT_MODEL=gpt-4.1-mini
# OPENAI_TTS_MODEL=tts-1

# Supertonic 로컬 음성 모델. 처음 쓸 때 Hugging Face에서 내려받음 (약 260MB)
# SUPERTONIC_MODEL=supertonic-2
NAVER_BLOG_IDS=["copper567"]
# STORAGE_DIR=./storage
